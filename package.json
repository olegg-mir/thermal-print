{
  "name": "thermal-print",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts index.html package.json tsconfig.json README.md AGENTS.md docs .github/workflows/pages.yml",
    "format:check": "prettier --check src vite.config.ts index.html package.json tsconfig.json README.md AGENTS.md docs .github/workflows/pages.yml",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.8",
    "@fontsource/noto-serif": "^5.2.8",
    "@material/web": "^2.5.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.2"
  }
}
